generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  RESTAURANT
  COURIER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  email      String  @unique
  password   String
  name       String
  avatarPath String  @default("/uploads/default-avatar.png") @map("avatar_path")
  phone      String  @default("")
  address    String  @default("")
  pushToken  String? @map("push_token")
  role       Role    @default(USER)

  orders                  Order[]                @relation("CustomerOrders")
  courierOrders           Order[]                @relation("CourierOrders")
  restaurants             Restaurant[]
  serviceFeeSettlements   ServiceFeeSettlement[] @relation("CourierSettlements")
  confirmedFeeSettlements ServiceFeeSettlement[] @relation("ConfirmedSettlements")

  @@index([email])
  @@index([name])
  @@map("users")
}

model Restaurant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name  String @unique
  slug  String @unique
  image String

  openTime  String? @map("open_time")
  closeTime String? @map("close_time")

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  products Product[]

  @@map("restaurant")
}

model Category {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  name  String @unique
  slug  String @unique
  emoji String @default("🍽️")

  products Product[]

  @@map("categories")
}

model Product {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name        String
  slug        String
  description String?
  price       Int
  image       String?
  isAvailable Boolean @default(true) @map("is_available")

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  categoryId String?  @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  @@unique([restaurantId, slug])
  @@map("product")
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reference String @unique
  status    String @default("PENDING")
  type      String @default("FOOD")
  total     Int

  deliveryAddress  String?   @map("delivery_address")
  deliveryTime     DateTime? @map("delivery_time")
  deliveryLat      Float?    @map("delivery_lat")
  deliveryLng      Float?    @map("delivery_lng")
  deliveryFee      Int       @default(150) @map("delivery_fee")
  serviceFee       Int       @default(0) @map("service_fee")
  comment          String?

  destinationAddress String? @map("destination_address")
  destinationLat     Float?  @map("destination_lat")
  destinationLng     Float?  @map("destination_lng")

  userId String?
  user   User?   @relation("CustomerOrders", fields: [userId], references: [id])

  courierId        String?   @map("courier_id")
  courier          User?     @relation("CourierOrders", fields: [courierId], references: [id])
  courierLat       Float?    @map("courier_lat")
  courierLng       Float?    @map("courier_lng")
  courierUpdatedAt DateTime? @map("courier_updated_at")

  serviceFeeSettlementId String?               @map("service_fee_settlement_id")
  serviceFeeSettlement   ServiceFeeSettlement? @relation(fields: [serviceFeeSettlementId], references: [id])

  items OrderItem[]

  @@index([userId])
  @@index([courierId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([serviceFeeSettlementId])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity     Int    @default(1)
  price        Int
  productName  String @map("product_name")
  productImage String @map("product_image")

  @@unique([orderId, productId])
  @@map("order_items")
}


model Settings {
  id    String @id @default("default")
  deliveryFee  Int @default(150) @map("delivery_fee")
  serviceFee   Int @default(50) @map("service_fee")
  taxiFee      Int @default(200) @map("taxi_fee")

  @@map("settings")
}

model ServiceFeeSettlement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  amount      Int
  courierName String @map("courier_name")

  courierId String? @map("courier_id")
  courier   User?   @relation("CourierSettlements", fields: [courierId], references: [id], onDelete: SetNull)

  confirmedById String? @map("confirmed_by_id")
  confirmedBy   User?   @relation("ConfirmedSettlements", fields: [confirmedById], references: [id], onDelete: SetNull)

  orders Order[]

  @@index([courierId])
  @@index([createdAt])
  @@map("service_fee_settlements")
}